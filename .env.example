# Neon — pooled string for the app (host contains "-pooler").
DATABASE_URL=""
# Neon — direct string, used only by `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Where the app is served, used in member links and calendar files.
APP_URL="http://localhost:3000"

# The owner account, created the first time you sign in with these.
# Change the password from Settings afterwards.
OWNER_EMAIL=""
OWNER_INITIAL_PASSWORD=""
